#!/bin/bash

# Prompter 一键启动文件 - 双击即可运行
# 文件名: "click me"
#
# 🎯 使用方法:
# 1. 在Finder中双击这个文件
# 2. 或在终端中运行: ./click\ me
# 3. 选择启动模式即可开始使用

set -e

# 确保在正确的工作目录
if [ -n "${BASH_SOURCE[0]}" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
elif [ -n "$0" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
else
    SCRIPT_DIR="$(pwd)"
fi

cd "$SCRIPT_DIR"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# 获取脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# 打开新终端窗口并运行
open_terminal_and_run() {
    local command="$1"

    # 检测当前终端类型
    if [[ "$TERM_PROGRAM" == "Apple_Terminal" ]]; then
        # 使用 Terminal.app
        osascript <<EOF
tell application "Terminal"
    activate
    do script "cd '$SCRIPT_DIR' && $command"
end tell
EOF
    elif [[ "$TERM_PROGRAM" == "iTerm.app" ]] || [[ -n "$ITERM_SESSION_ID" ]]; then
        # 使用 iTerm
        osascript <<EOF
tell application "iTerm"
    activate
    create window with default profile
    tell current session of current window
        write text "cd '$SCRIPT_DIR' && $command"
    end tell
end tell
EOF
    else
        # 使用默认的 open 命令
        open -a Terminal "$SCRIPT_DIR"
        sleep 2
        osascript <<EOF
tell application "Terminal"
    activate
    do script "$command" in front window
end tell
EOF
    fi
}

# 主启动界面
show_main_menu() {
    clear
    echo -e "${BLUE}"
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║                    🤖 PROMPTER                          ║"
    echo "║                 一键启动菜单                              ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    echo ""
    echo -e "${WHITE}选择启动模式:${NC}"
    echo ""
    echo -e "${CYAN}1.${NC} 🎨 可视化监控模式 (推荐)"
    echo "   • 专业监控界面"
    echo "   • 活跃终端检测"
    echo "   • HTTP状态码响应"
    echo ""
    echo -e "${CYAN}2.${NC} ⚡ 快速监控模式"
    echo "   • 立即开始监控"
    echo "   • 简洁输出"
    echo ""
    echo -e "${CYAN}3.${NC} 🔧 自动化配置模式"
    echo "   • 配置Cloudflare上传"
    echo "   • 定时自动同步"
    echo ""
    echo -e "${CYAN}4.${NC} 🎬 功能演示"
    echo "   • 查看界面预览"
    echo "   • 了解所有功能"
    echo -e "${CYAN}5.${NC} ❓ 查看帮助"
    echo ""
    echo -e "${YELLOW}💡 首次使用推荐选择 '1' 可视化模式${NC}"
    echo ""

    read -p "请选择 (1-5) [1]: " choice
    choice=${choice:-1}

    case $choice in
        1)
            echo -e "${GREEN}启动可视化监控模式...${NC}"
            open_terminal_and_run "./start_visual_monitor.sh"
            ;;
        2)
            echo -e "${GREEN}启动快速监控模式...${NC}"
            # 先编译项目
            if [ ! -f "./target/release/prompter" ]; then
                echo "正在编译项目..."
                cargo build --release > /dev/null 2>&1
            fi
            open_terminal_and_run "./target/release/prompter --shell-monitor"
            ;;
        3)
            echo -e "${GREEN}启动自动化配置模式...${NC}"
            open_terminal_and_run "./auto_start.sh"
            ;;
        4)
            echo -e "${GREEN}显示功能演示...${NC}"
            ./demo_visual.sh
            echo ""
            echo "按任意键继续..."
            read -n 1
            show_main_menu
            ;;
        5)
            show_help
            ;;
        *)
            echo -e "${RED}无效选择，请重试${NC}"
            sleep 1
            show_main_menu
            ;;
    esac
}

# 显示帮助信息
show_help() {
    clear
    echo -e "${BLUE}🤖 Prompter - 智能Claude提示词监控工具${NC}"
    echo ""
    echo -e "${WHITE}什么是 Prompter?${NC}"
    echo "Prompter 是一个Rust编写的工具，能够："
    echo "• 在独立终端监控所有Claude命令"
    echo "• 自动识别和保存中文提示词"
    echo "• 提供可视化监控界面"
    echo "• 支持自动上传到Cloudflare和GitHub"
    echo ""
    echo -e "${WHITE}如何使用?${NC}"
    echo "1. 双击运行这个 'click me' 文件"
    echo "2. 选择启动模式"
    echo "3. 在其他终端正常使用Claude命令"
    echo "4. 监控器会自动捕获中文提示词"
    echo ""
    echo -e "${WHITE}支持的命令:${NC}"
    echo "• claude \"帮我写一个函数\""
    echo "• claude-code \"优化这段代码\""
    echo "• claude \"设计数据库结构\""
    echo ""
    echo -e "${WHITE}输出位置:${NC}"
    echo "• 本地文件: ./data/shell_captured_prompts.md"
    echo "• 可选上传: Cloudflare + GitHub"
    echo ""
    echo -e "${WHITE}系统要求:${NC}"
    echo "• macOS, Linux, Windows"
    echo "• Rust 1.70+"
    echo "• bash, zsh, fish (任意一种Shell)"
    echo ""
    echo -e "${YELLOW}GitHub仓库: https://github.com/ink1ing/prompter${NC}"
    echo ""
    read -p "按Enter返回主菜单..."
    show_main_menu
}

# 检查环境
check_environment() {
    # 检查是否在正确目录
    if [ ! -f "Cargo.toml" ]; then
        echo -e "${RED}错误: 未找到 Cargo.toml 文件${NC}"
        echo "请确保在项目根目录运行此文件"
        exit 1
    fi

    # 检查Rust环境
    if ! command -v cargo >/dev/null 2>&1; then
        echo -e "${RED}错误: 未找到 Rust/Cargo${NC}"
        echo "请安装 Rust: https://rustup.rs/"
        exit 1
    fi
}

# 欢迎信息
print_welcome() {
    clear
    echo -e "${PURPLE}"
    echo "    ____                            __           "
    echo "   / __ \\________  ____ ___  ____  / /____  _____"
    echo "  / /_/ / ___/ _ \\/ __ \`__ \\/ __ \\/ __/ _ \\/ ___/"
    echo " / ____/ /  /  __/ / / / / / /_/ / /_/  __/ /    "
    echo "/_/   /_/   \\___/_/ /_/ /_/ .___/\\__/\\___/_/     "
    echo "                        /_/                     "
    echo -e "${NC}"
    echo -e "${CYAN}🤖 智能Claude提示词监控和收集工具${NC}"
    echo -e "${YELLOW}📍 独立终端监控 • 可视化界面 • 自动上传${NC}"
    echo ""
    echo -e "${GREEN}✅ 项目已就绪，选择启动方式...${NC}"
    echo ""
    sleep 2
}

# 主函数
main() {
    # 检查环境
    check_environment

    # 显示欢迎信息
    print_welcome

    # 显示主菜单
    show_main_menu
}

# 错误处理
trap 'echo -e "\n${RED}程序已中断${NC}"; exit 1' INT TERM

# 运行主函数
main "$@"